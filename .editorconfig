# EditorConfig is awesome: https://EditorConfig.org

root = true

[*.ps1]
charset = utf-8-bom
indent_size = 4
indent_style = space
insert_final_newline = true

[*.{yml,yaml,json,py}]
charset = utf-8
indent_size = 2
indent_style = space
insert_final_newline = true

[*.md]
charset = utf-8
insert_final_newline = true
